# =============================================================================
# CodeSeek V2 Production Environment Variable Template (.env.example)
# =============================================================================
# Copy this file to '.env' in the project root to configure the Docker Compose stack.
# DO NOT commit real production passwords or keys to version control!

# -----------------------------------------------------------------------------
# 1. Routing and Domain Settings
# -----------------------------------------------------------------------------
# Domain name for Caddy automatic HTTPS. Leave as 'localhost' for local deployment.
CODESEEK_DOMAIN=codeseek.atharvapagar.xyz

# -----------------------------------------------------------------------------
# 2. Security & Credentials
# -----------------------------------------------------------------------------
# API key to authenticate requests between clients and the backend services.
CODESEEK_API_KEY=replace_with_a_secure_random_api_key

# 32+ character key for DB encryption/decryption. Keep this stable or encrypted data is lost!
CODESEEK_APP_ENCRYPTION_KEY=replace_with_32_plus_random_characters_key

# -----------------------------------------------------------------------------
# 3. PostgreSQL Database
# -----------------------------------------------------------------------------
# Database name, credentials, and password for Postgres.
POSTGRES_DB=codeseek
POSTGRES_USER=codeseek
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# Database URL used by the backend. Note the 'postgres' hostname (Compose service).
CODESEEK_DATABASE_URL=postgresql://codeseek:replace_with_a_strong_database_password@postgres:5432/codeseek
CODESEEK_DB_BACKEND=postgres

# -----------------------------------------------------------------------------
# 4. Vector Database (Qdrant)
# -----------------------------------------------------------------------------
# Settings to connect the backend to the Qdrant service inside the Docker network.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# -----------------------------------------------------------------------------
# 5. Security & Session Configurations
# -----------------------------------------------------------------------------
CODESEEK_TENANT_ID=local_prod
CODESEEK_REQUIRE_EXPLICIT_APP_ENCRYPTION_KEY=1
CODESEEK_AUTH_SESSION_SECURE_COOKIE=1
CODESEEK_ENFORCE_HTTPS=1
CODESEEK_ALLOW_PLAINTEXT_SECRET_SUBMISSION=1

# -----------------------------------------------------------------------------
# 6. ML / Embedding Configurations
# -----------------------------------------------------------------------------
CODESEEK_EMBEDDING_PROVIDER=openai_compatible
CODESEEK_EMBEDDING_BASE_URL=https://api.aicredits.in/v1
CODESEEK_EMBEDDING_API_KEY=replace_with_your_api_key
CODESEEK_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# 7. Frontend Build variables
# -----------------------------------------------------------------------------
# Path route where client fetches the APIs. Keeping it relative '/api' is recommended.
VITE_API_BASE_URL=/api

# -----------------------------------------------------------------------------
# 8. GitHub OAuth Settings
# -----------------------------------------------------------------------------
# GitHub OAuth application credentials.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://codeseek.atharvapagar.xyz/auth/github/callback
CODESEEK_FRONTEND_URL=https://codeseek.atharvapagar.xyz
CODESEEK_CORS_ORIGINS=https://codeseek.atharvapagar.xyz
